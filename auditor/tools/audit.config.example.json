{
  "baseUrl": "http://localhost:3100",
  "_baseUrl_note": "port auditorovy instance (build-env.mjs up --port 3100) — NE Kapitánův dev server na 3000",
  "isolatedEnv": false,
  "_isolatedEnv_note": "true JEN pro oddělenou DB/port/účty (žádná živá data). false = crawler blokuje mutační a externí požadavky a rizikové GET (seed/migrate/reset…).",
  "screens": [
    { "name": "login", "path": "/login", "auth": false },
    { "name": "dashboard", "path": "/", "auth": true },
    { "name": "contacts", "path": "/contacts", "auth": true },
    { "name": "settings", "path": "/settings", "auth": true }
  ],
  "viewports": {
    "mobile": { "width": 390, "height": 844, "isMobile": true, "hasTouch": true },
    "tablet": { "width": 768, "height": 1024 },
    "desktop": { "width": 1440, "height": 900 }
  },
  "auth": {
    "storageStateFile": "AUDIT/.auth/tenantA.json",
    "note": "storageState vytvoř jednorázově přihlášením testovacího účtu (npx playwright codegen --save-storage). Nikdy produkční účet."
  },
  "menuSelectors": {
    "dropdownTrigger": "[data-testid$='-menu-trigger'], [aria-haspopup='menu'], [aria-haspopup='listbox']",
    "dropdownContent": "[role='menu'], [role='listbox'], [data-radix-popper-content-wrapper]",
    "navItems": "nav a, [role='navigation'] a"
  },
  "tenants": {
    "A": { "storageState": "AUDIT/.auth/tenantA.json", "sampleIds": { "contact": "[DOPLŇ id kontaktu tenantu A]", "quote": "[DOPLŇ]" } },
    "B": { "storageState": "AUDIT/.auth/tenantB.json", "sampleIds": { "contact": "[DOPLŇ id kontaktu tenantu B]", "quote": "[DOPLŇ]" } }
  },
  "endpoints": {
    "discover": "app/api/**/route.ts",
    "manual": [
      { "method": "GET", "path": "/api/contacts/{contact}", "idParam": "contact" },
      { "method": "PATCH", "path": "/api/contacts/{contact}", "idParam": "contact", "body": { "role": "admin", "tenantId": "x" } }
    ],
    "adminOnly": ["/api/settings/users", "/api/billing"]
  }
}
