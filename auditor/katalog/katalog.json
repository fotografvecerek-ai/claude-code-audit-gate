      "zdroj": "skilly/uzavrena-smycka",
      "pro": [
        "kapitan"
      ],
      "k_cemu": "uzavřená QA smyčka pro dávku ≥3 issues: formalizuj → oprav → nezávisle ověř → review → vydej → pouč se",
      "doporucit": [
        "kapitan"
      ],
      "souvisi": [
        "kontrakt-formalizator",
        "overovatel-nezavisly",
        "code-reviewer"
      ]
    },
