      "typ": "hook",
      "zdroj": "hooky/kontrola-skriptu.mjs",
      "pro": [
        "kapitan"
      ],
      "k_cemu": "po zápisu skriptu hned kontrola syntaxe (JS, Python, PowerShell 5.1 vč. diakritiky bez BOM, shell, JSON)",
      "hooky": [
        {
          "udalost": "PostToolUse",
          "matcher": "Write|Edit|MultiEdit"
        }
      ],
      "signaly": [
        "skripty"
      ],
      "harness": [
        "claude"
      ]
    },
    {
      "id": "commit-syntaxe",
      "typ": "hook",
      "zdroj": "hooky/commit-syntaxe.mjs",
      "pro": [
