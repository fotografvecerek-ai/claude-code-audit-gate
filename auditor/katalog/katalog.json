      ],
      "k_cemu": "před commitem: jen jmenovitý git add/commit (ne -A/-a) a kontrola syntaxe commitovaných souborů",
      "hooky": [
        {
          "udalost": "PreToolUse",
          "matcher": "Bash|PowerShell"
        }
      ],
      "signaly": [
        "typescript",
        "python"
      ],
      "harness": [
        "claude"
      ]
    },
    {
      "id": "sdileny-strom",
      "typ": "hook",
      "zdroj": "hooky/sdileny-strom.mjs",
      "pro": [
        "kapitan"
      ],
      "k_cemu": "blok hromadného ukončování procesů podle jména a destruktivních git operací (stash, reset --hard, checkout --, clean -f)",
      "hooky": [
        {
          "udalost": "PreToolUse",
          "matcher": "Bash|PowerShell"
        }
      ],
      "doporucit": [
        "kapitan"
      ],
      "harness": [
        "claude"
      ]
    },
    {
      "id": "stav-kompakce",
      "typ": "hook",
      "zdroj": "hooky/stav-kompakce.mjs",
      "pro": [
        "kapitan"
      ],
      "k_cemu": "od 1.8.8 součást výchozího nastavení Kapitána (tools/stav-session.mjs, i po /clear) — aktivuj jen u projektu bez strany Kapitána",
      "hooky": [
        {
          "udalost": "SessionStart",
          "matcher": "compact"
        }
      ],
      "doporucit": [],
      "harness": [
        "claude"
      ],
      "sablona": {
        "z": "pravidla/STATE.md.sablona",
        "do": ".claude/STATE.md"
      }
    }
