# AUDIT/.auth/.env.audit — TESTOVACÍ prostředí pro auditorovu instanci (build-env.mjs up). Dodává Pavel. NIKDY produkční hodnoty.
# Doporučeno: Supabase branch (izolovaná DB se stejným schématem) nebo lokální Postgres v Dockeru; testovací účty tenantů A/B.
AUDIT_ENV_OK=1   # povinné — potvrzení, že hodnoty níže jsou testovací (skript odmítne sk_live_, NODE_ENV=production, SERVICE_ROLE)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/audit
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/audit
NEXT_PUBLIC_SUPABASE_URL=https://<branch-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key testovací branch>
AUTH_SECRET=<náhodných 32+ znaků jen pro audit>
AUTH_URL=http://localhost:3100
# e-maily/platby/OTA: sandbox nebo vypnuto
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
STRIPE_SECRET_KEY=sk_test_<sandbox>
